#!/bin/sh
set -eu

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

BIN=$(command -v qs 2>/dev/null || command -v quickshell 2>/dev/null || true)
if [ -z "$BIN" ]; then
    echo "quicklock: quickshell not found in PATH" >&2
    exit 127
fi

: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"

export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_ENABLE_HIGHDPI_SCALING=0
export QML_DISABLE_DISK_CACHE=0
export QT_LOGGING_RULES="${QT_LOGGING_RULES:-qt.qpa.*=false}"

exec flock -n "$XDG_RUNTIME_DIR/quicklock.lock" "$BIN" -p "$DIR/shell.qml" "$@"
