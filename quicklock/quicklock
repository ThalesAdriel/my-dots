#!/bin/sh
set -eu

DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

BIN=$(command -v qs 2>/dev/null || command -v quickshell 2>/dev/null || true)
if [ -z "$BIN" ]; then
    echo "quicklock: quickshell not found in PATH" >&2
    exit 127
fi

: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"

export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_ENABLE_HIGHDPI_SCALING=0
export QT_LOGGING_RULES="${QT_LOGGING_RULES:-qt.qpa.*=false}"
# Quickshell's jemalloc: two arenas and a background purge, so freed memory goes back instead of piling up.
export MALLOC_CONF="${MALLOC_CONF:-narenas:2,background_thread:true}"

# NVIDIA's EGL alone when it is the only GPU: glvnd would also load Mesa and its LLVM, unused.
egl=/usr/share/glvnd/egl_vendor.d/10_nvidia.json
if [ -e "$egl" ] && ! ls -l /sys/class/drm/card[0-9]/device/driver /sys/class/drm/card[0-9][0-9]/device/driver 2>/dev/null | grep -qv '/nvidia$'; then
    export __EGL_VENDOR_LIBRARY_FILENAMES="$egl"
fi

exec flock -n "$XDG_RUNTIME_DIR/quicklock.lock" "$BIN" -p "$DIR/shell.qml" "$@"
